mail.host=smtp.gmail.com
mail.port=587
mail.username=your@gmail.com
mail.password=your-app-password
mail.from.address=your@gmail.com
mail.from.name=Narainsons

fast2sms.api.key=YOUR_FAST2SMS_KEY
fast2sms.route=dlt
fast2sms.sender.id=YOUR_DLT_SENDER
# Fast2SMS panel → DLT Manager → approved template → Message ID (sirf number/id)
fast2sms.dlt.message_id=YOUR_MESSAGE_ID

# Signs JWT access tokens, at least 32 characters. Changing it signs everyone out.
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
