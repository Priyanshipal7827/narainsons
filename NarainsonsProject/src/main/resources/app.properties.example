auth.enabled=false
auth.public.paths=/api/health
auth.api.key=change-this-secret-key

# true sirf local testing ke liye: OTP API response mein aata hai. Production par false.
app.dev.expose_otp=false

# Admin API key (X-Admin-Key header)
admin.api.key=CHANGE_ME

# POST /api/internal/emi-reminders, header X-Cron-Secret
cron.emi.secret=CHANGE_ME
emi.reminder.days_before=3

# Browser origins allowed to call the API, comma separated. Same-origin /admin and the mobile app do not need this.
cors.allowed.origins=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Contacts/gallery sync stays off unless compliance has approved it.
app.sync.contacts_gallery.enabled=false

session.admin.hours=12
session.user.days=30

# Gap between two reminders for one EMI. The cron can still run hourly. Set to 1 for hourly reminders.
emi.reminder.min_hours=24

# Access token lifetime. session.user.days is the refresh token lifetime.
jwt.access.minutes=60

# Business rules. 0 means no interest / no fee. Set your real values before going live.
loan.interest.annual_percent=0
loan.processing_fee.percent=0
loan.approve.require_kyc_verified=true

# Sends EMI reminders from inside the app every hour, so no Task Scheduler is needed.
emi.reminder.scheduler.enabled=true
